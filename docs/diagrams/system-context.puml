@startuml system-context
!theme plain
title LabBook - System Context

actor "Student" as S
actor "Lab Admin" as A
rectangle "LabBook on OpenChoreo" as LB {
  component "labbook-web\n(React SPA + nginx)" as WEB
  component "labbook-api\n(Ballerina)" as API
  component "labbook-scheduler\n(Ballerina)" as SCH
  database "PostgreSQL\n(OpenChoreo resource)" as DB
}
cloud "ThunderID\n(OIDC identity provider)" as IDP
cloud "OpenChoreo\n(build, deploy, run)" as OC
cloud "GitHub\n(source + Actions CI)" as GH

S --> WEB : browse, request bookings
A --> WEB : approve, manage labs
WEB --> IDP : sign in (OIDC, PKCE)
WEB --> API : REST, Bearer token
API --> IDP : verify token signature (JWKS)
API --> DB
SCH --> DB : expire / complete bookings
GH --> OC : source for builds
OC ..> LB : builds, deploys, runs
@enduml
