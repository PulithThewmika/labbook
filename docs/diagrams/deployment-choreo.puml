@startuml deployment-choreo
!theme plain
title LabBook - Deployment on Choreo

cloud "GitHub" as GH {
  artifact "labbook repo\n(backend / scheduler / frontend)" as REPO
}
cloud "Asgardeo" as IDP
database "PostgreSQL\n(Choreo-managed or Neon)" as DB

node "Choreo project: LabBook" {
  node "Development" as DEV {
    component "labbook-web" as W1
    component "API gateway" as G1
    component "labbook-api" as A1
    component "labbook-scheduler\n(cron */15 * * * *)" as S1
    W1 --> G1
    G1 --> A1
  }
  node "Production" as PROD {
    component "labbook-web" as W2
    component "API gateway" as G2
    component "labbook-api" as A2
    component "labbook-scheduler\n(cron */15 * * * *)" as S2
    W2 --> G2
    G2 --> A2
  }
}

REPO --> DEV : build + deploy
DEV --> PROD : promote same image
W1 --> IDP : managed auth
W2 --> IDP : managed auth
A1 --> DB : dev database
S1 --> DB
A2 --> DB : prod database
S2 --> DB
@enduml
