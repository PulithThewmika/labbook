@startuml ci-cd-flow
!theme plain
title CI/CD flow

start
:Developer opens pull request;
:GitHub Actions runs\nbackend, scheduler, frontend jobs;
if (all checks green?) then (yes)
  :Squash-merge to main;
  :OpenChoreo build workflow\n(dockerfile-builder) checks out main;
  :Build image from each Dockerfile\nand push to the registry;
  if (build succeeds?) then (yes)
    :Deploy to development\n(workload from workload.yaml);
    :Smoke test (sign in, book, conflict);
    if (tests pass?) then (yes)
      :Promote through staging\nto production;
    else (no)
      :Fix on a new branch;
      stop
    endif
  else (no)
    :Read the build log and fix;
    stop
  endif
else (no)
  :Fix and push again;
  stop
endif
stop
@enduml
